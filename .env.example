# Vigilience production environment - TEMPLATE ONLY.
#
# Copy to the server (never into the Git checkout):
#   install -m 600 .env.example ~/.config/vigilience/production.env
# then edit the values. This file is read by Docker Compose (--env-file) and
# by the scripts in scripts/. It must never be committed.

TZ=America/Toronto

# Pinned image versions. Update deliberately; see docs/deployment.md.
HA_VERSION=2026.10.2
GLANCES_VERSION=4.5.8
SOCKET_PROXY_VERSION=1.13.1

# Media drive mount point on the host (read-only inside Glances).
MEDIA_MOUNT=/mnt/media

# Loopback-only helper ports on the server.
GLANCES_PORT=61208
DOCKER_PROXY_PORT=2375

# Dashboard PIN gate. Do not edit by hand: scripts/set-pin.sh writes both
# (PBKDF2 hash of the PIN + cookie signing key). Changing the PIN signs
# every device out.
PIN_GATE_PIN_HASH=
PIN_GATE_SECRET=
# Loopback port Home Assistant listens on behind the gate.
HA_INTERNAL_PORT=8124

# Numeric id of the host's docker group (run: getent group docker | cut -d: -f3).
# The socket proxy runs as nobody:<this group> instead of root.
DOCKER_GID=

# --- Private network values (server-only) ---------------------------------
# Home gateway address to ping (e.g. the router's LAN IP).
VIG_GATEWAY_HOST=
# Two independent internet hosts to ping.
VIG_INTERNET_HOST_1=1.1.1.1
VIG_INTERNET_HOST_2=9.9.9.9

# Server LAN IP that homelab apps publish on (homelab-deploy), and the home
# subnet in CIDR form allowed to reach app ports 8200-8299
# (scripts/homelab-firewall.sh).
VIG_LAN_IP=
VIG_LAN_SUBNET=

# Quick-link URLs shown on the dashboard (as reachable from your phone/Mac).
VIG_IMMICH_URL=
VIG_PLEX_URL=
VIG_ROUTER_URL=
VIG_VPN_URL=
